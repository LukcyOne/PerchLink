{
  "name": "perchlink",
  "private": true,
  "packageManager": "pnpm@10",
  "scripts": {
    "dev:web": "pnpm --filter @perchlink/web dev",
    "dev:desktop": "pnpm --filter @perchlink/desktop dev",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "test": "pnpm exec vitest run --passWithNoTests",
    "lint": "pnpm exec eslint .",
    "build:web": "pnpm --filter @perchlink/web build",
    "build:desktop": "pnpm --filter @perchlink/desktop build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.8.1",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
