{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@perchlink/core": ["packages/core/src/index.ts"],
      "@perchlink/store": ["packages/store/src/index.ts"],
      "@perchlink/ui": ["packages/ui/src/index.ts"],
      "@perchlink/i18n": ["packages/i18n/src/index.ts"]
    }
  }
}
